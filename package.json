{
  "name": "alps-personal-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "admin:setup": "node scripts/setup-admin.mjs",
    "admin:reset": "node --import tsx scripts/reset-admin-password.mjs",
    "deploy:config": "node scripts/deployment-config.mjs",
    "deploy:migrate": "node --import tsx scripts/migrate-to-turso.mjs",
    "brand:generate": "node scripts/export-brand-images.mjs",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@libsql/client": "0.18.0",
    "better-sqlite3": "13.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
