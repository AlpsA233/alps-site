# Run npm run admin:setup to generate .env.local with a scrypt password hash.
ADMIN_PASSWORD_HASH=
# Local development / a self-hosted Node server with persistent storage.
# Ignored whenever TURSO_DATABASE_URL is set; do not set DATABASE_PATH on Vercel.
DATABASE_PATH=data/alps.sqlite
# Vercel: both values are required. Use a Turso libSQL database and a read/write token.
# Keep these server-only; never use a NEXT_PUBLIC_ prefix for database credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Production HTTPS is required; set false ONLY for a local production smoke test.
COOKIE_SECURE=true
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional image uploads: R2 Standard + a read-only Cloudflare Worker.
# Keep credentials server-only. The public base is an HTTPS origin, without a path.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
